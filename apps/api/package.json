{
  "name": "@agent-app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @agent-app/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @agent-app/contracts build",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@agent-app/contracts": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
